{
  "name": "smartagri92-web",
  "version": "0.1.0",
  "private": true,
  "description": "Tableau de bord SmartAgri92 (Next.js App Router, BFF à cookies httpOnly).",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:coverage": "vitest run --coverage",
    "dev:mock": "node scripts/dev-mock.mjs",
    "test:e2e": "playwright test",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.80.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "15.5.29",
    "next-intl": "3.26.5",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "react-is": "19.0.9",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
