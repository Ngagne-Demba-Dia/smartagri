# SmartAgri92 — variables d'environnement du backend (copier en .env, ne jamais committer .env).
# Confidentiel — réservé aux partenaires de travail.

# --- Socle (CONVENTIONS §7) ---------------------------------------------------------------
APP_ENV=local                       # local | test | staging | prod (staging/prod : contrôles stricts)
DATABASE_URL=postgresql+psycopg://agri_api:CHANGER@localhost:5432/smartagri92
# Migrations (python -m app.db.migrate) : rôle propriétaire du schéma, distinct de agri_api.
MIGRATION_DATABASE_URL=postgresql://agri_owner:CHANGER@localhost:5432/smartagri92
MIGRATIONS_DIR=../db/migrations      # /app/migrations dans l’image
JWT_SECRET=                         # ≥ 32 octets en staging/prod (ex. `openssl rand -hex 32`)
DEVICE_KEY_PEPPER=                  # ≥ 32 octets en staging/prod ; HMAC des clés de kit
MQTT_URL=mqtt://localhost:1883      # mqtts://broker:8883 obligatoire en staging/prod
MQTT_USERNAME=
MQTT_PASSWORD=
S3_ENDPOINT=
S3_BUCKET_RAW=agri-raw
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
MLFLOW_TRACKING_URI=                # lu par ml/ uniquement (non utilisé par l'API)

# --- Assistant ----------------------------------------------------------------------------
ASSISTANT_EFFORT=medium             # low | medium | high
ASSISTANT_MAX_ITERATIONS=6
ASSISTANT_SERVER_FALLBACK=true      # repli serveur (bêta server-side-fallback-2026-07-01)

# --- Météo (Open-Meteo) --------------------------------------------------------------------
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=180
WEATHER_TIMEOUT_S=10

# --- Inférence -----------------------------------------------------------------------------
INFERENCE_BACKEND=local             # none | local | octopus
MODEL_BUNDLE_DIR=./models           # paquets joblib/ONNX vérifiés par SHA-256 (model_registry)
OCTOPUS_BASE_URL=https://octopus.ml # à vérifier avec l'équipe OctOpus ; HTTPS obligatoire en staging/prod
OCTOPUS_API_KEY=
OCTOPUS_TIMEOUT_S=60

# --- HTTP ----------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ASSISTANT_PER_MIN=20
METRICS_ENABLED=true
AUTO_CREATE_SCHEMA=false            # vrai par défaut sur SQLite ; toujours faux en staging/prod

# --- Règles d'alerte -----------------------------------------------------------------------
DEVICE_SILENT_HOURS=24
DRY_SOIL_HOURS=2
DISEASE_CONSECUTIVE=3
DISEASE_MIN_CONFIDENCE=0.7
DISEASE_WINDOW_HOURS=48

# --- Mode hybride par service (partagé avec le BFF du Frontend) ------------------------------
# AGRI_MOCK = défaut de tous les services (1 = simulation, 0 = réel) ; AGRI_SERVICES = exceptions.
AGRI_MOCK=1
AGRI_SERVICES=                      # ex. irrigation_need=real,kit_parameters=mock,device_health=mock
