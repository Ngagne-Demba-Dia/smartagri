# Modèle de configuration locale. Copier en .env puis remplacer chaque CHANGER_MOI.
# Générer chaque secret indépendamment : openssl rand -hex 32
# Ne jamais commiter .env (ignoré par git). En production, ces valeurs viennent d'AWS Secrets Manager
# via External Secrets (voir infra/k8s/base/app/external-secrets.yaml et infra/k8s/base/ml/external-secrets.yaml).

APP_ENV=local

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=agri
POSTGRES_DB=agri
POSTGRES_PASSWORD=CHANGER_MOI
MLFLOW_DB_PASSWORD=CHANGER_MOI

# --- Secrets applicatifs (>= 32 octets chacun) ---
JWT_SECRET=CHANGER_MOI
DEVICE_KEY_PEPPER=CHANGER_MOI

# --- MQTT (comptes hachés dans infra/mosquitto/secrets/passwd par « make mqtt-passwd ») ---
MQTT_INGESTOR_USER=ingestor
MQTT_INGESTOR_PASSWORD=CHANGER_MOI
MQTT_API_USER=api
MQTT_API_PASSWORD=CHANGER_MOI
MQTT_HEALTH_PASSWORD=CHANGER_MOI

# --- MinIO (S3 local) ---
MINIO_ROOT_USER=CHANGER_MOI
MINIO_ROOT_PASSWORD=CHANGER_MOI
# Utilisateur applicatif distinct du compte root (créé par minio-init)
S3_ACCESS_KEY=CHANGER_MOI
S3_SECRET_KEY=CHANGER_MOI
S3_BUCKET_RAW=agri-raw
AWS_REGION=eu-west-3

# --- Assistant agronomique (laisser vide pour désactiver l'assistant en local) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# --- Inférence IA ---
# none : désactivée | local : paquets de modèles de ml/artifacts/bundles | octopus : API OctOpus
INFERENCE_BACKEND=local
OCTOPUS_BASE_URL=https://octopus.ml
# Laisser vide hors usage d'OctOpus ; ne jamais commiter de clé réelle.
OCTOPUS_API_KEY=

# --- Web (origine du tableau de bord Next.js en développement) ---
CORS_ORIGINS=http://localhost:3000

# --- Observabilité (profil « observability ») ---
GRAFANA_ADMIN_PASSWORD=CHANGER_MOI
